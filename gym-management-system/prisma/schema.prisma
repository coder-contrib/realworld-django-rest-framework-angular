generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../storage/database.sqlite"
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  fullName  String
  role      String   @default("reception") // admin, reception, trainer, accountant
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Member {
  id             String         @id @default(cuid())
  fullName       String
  phone          String
  emergencyPhone String?
  email          String?
  gender         String         @default("male") // male, female
  birthDate      DateTime?
  image          String?
  qrCode         String?        @unique
  notes          String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  subscriptions  Subscription[]
  attendances    Attendance[]
  payments       Payment[]
  measurements   Measurement[]
}

model Subscription {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type      String   // monthly, quarterly, semi_annual, annual
  price     Float
  startDate DateTime
  endDate   DateTime
  status    String   @default("active") // active, frozen, expired, cancelled
  frozenAt  DateTime?
  frozenDays Int     @default(0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Attendance {
  id       String   @id @default(cuid())
  memberId String
  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  checkIn  DateTime @default(now())
  checkOut DateTime?
}

model Payment {
  id            String   @id @default(cuid())
  memberId      String
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  amount        Float
  paymentMethod String   // cash, bank_transfer, wallet
  invoiceNumber String   @unique
  description   String?
  notes         String?
  createdAt     DateTime @default(now())
}

model Trainer {
  id           String    @id @default(cuid())
  fullName     String
  phone        String
  email        String?
  specialization String
  image        String?
  isActive     Boolean   @default(true)
  salary       Float?
  schedule     String?   // JSON string for schedule
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     TrainingSession[]
}

model TrainingSession {
  id          String   @id @default(cuid())
  trainerId   String
  trainer     Trainer  @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  name        String
  dayOfWeek   String
  startTime   String
  endTime     String
  maxCapacity Int      @default(20)
  createdAt   DateTime @default(now())
}

model NutritionPlan {
  id          String   @id @default(cuid())
  memberId    String
  title       String
  description String?
  meals       String   // JSON string
  calories    Int?
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WorkoutPlan {
  id          String   @id @default(cuid())
  memberId    String
  title       String
  description String?
  exercises   String   // JSON string
  daysPerWeek Int      @default(3)
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Measurement {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  weight    Float?
  height    Float?
  bodyFat   Float?
  muscle    Float?
  chest     Float?
  waist     Float?
  hips      Float?
  arms      Float?
  image     String?
  notes     String?
  createdAt DateTime @default(now())
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  cost        Float?
  stock       Int      @default(0)
  minStock    Int      @default(5)
  category    String?
  image       String?
  barcode     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  memberId      String?
  totalAmount   Float
  discount      Float         @default(0)
  finalAmount   Float
  paymentMethod String        // cash, bank_transfer, wallet
  status        String        @default("paid") // paid, pending, cancelled
  notes         String?
  createdAt     DateTime      @default(now())
  items         InvoiceItem[]
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId String
  name      String
  quantity  Int
  price     Float
  total     Float
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model Backup {
  id        String   @id @default(cuid())
  filename  String
  size      Int
  type      String   // auto, manual
  createdAt DateTime @default(now())
}
